# Copie para .env e preencha. O .env é ignorado pelo git e bloqueado no commit.

# PostgreSQL
DATABASE_URL="postgresql://rids:rids@localhost:5432/rids?schema=public"

# Redis (filas BullMQ)
REDIS_URL="redis://localhost:6379"

# Chave de 32 bytes em base64 para cifrar tokens em repouso.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# App Shopify (Partner Dashboard). Uma app, várias lojas.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_products,write_products,read_orders,write_orders,read_fulfillments,write_fulfillments"
# Host público onde o RIDS recebe OAuth e webhooks, sem protocolo.
APP_HOST="localhost:3000"
